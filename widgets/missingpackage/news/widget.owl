widget "news" {
  meta { description: "Feeds, Hacker News and Lobsters in one list, with a tab per source"; version: "1.0"; license: "MIT"; category: "news" }
  size: 6x5
  minSize: 4x3

  requires { pacman: ["python"] }

  // Feeds come from ~/.config/omarchy-proot/feeds (one URL per line), the same list the feeds widget reads.
  // All three are fetched in parallel; one that is unreachable comes back empty.
  source news = cmd("""
    f=~/.config/omarchy-proot/feeds
    mkdir -p "$(dirname "$f")"
    [ -f "$f" ] || { echo https://archlinux.org/feeds/news/; echo https://github.com/omacom/omarchy/releases.atom; } > "$f"
    grep -v '^#' "$f" | grep . | python3 -c '
import sys, json, urllib.request, xml.etree.ElementTree as ET
from concurrent.futures import ThreadPoolExecutor
from datetime import datetime
from email.utils import parsedate_to_datetime
from urllib.parse import urlsplit

A = "{http://www.w3.org/2005/Atom}"
HN = "https://news.ycombinator.com/item?id="

def get(url):
    req = urllib.request.Request(url, headers={"User-Agent": "omarchy-proot news widget"})
    return urllib.request.urlopen(req, timeout=10).read()

def when(s):
    try:
        return int(parsedate_to_datetime(s).timestamp())
    except Exception:
        try:
            return int(datetime.fromisoformat(s.strip().replace("Z", "+00:00")).timestamp())
        except Exception:
            return 0

def text(e, *tags):
    for t in tags:
        x = e.find(t)
        if x is not None and x.text:
            return " ".join(x.text.split())
    return ""

def post(kind, title, url, at, label, disc="", pts=None, com=None):
    return {"id": kind + ":" + (disc or url), "kind": kind, "title": title, "url": url, "at": at,
            "label": label, "disc": disc, "pts": pts, "com": com}

def feed(url):
    try:
        root = ET.fromstring(get(url))
    except Exception:
        return []
    out = []
    ch = root.find("channel")
    if ch is not None:
        name = text(ch, "title")
        for i in ch.findall("item"):
            out.append(post("feed", text(i, "title"), text(i, "link"), when(text(i, "pubDate")), name))
    else:
        name = text(root, A + "title")
        for e in root.findall(A + "entry"):
            link = e.find(A + "link[@rel=\"alternate\"]")
            if link is None:
                link = e.find(A + "link")
            href = link.get("href") if link is not None else ""
            out.append(post("feed", text(e, A + "title"), href, when(text(e, A + "published", A + "updated")), name))
    return out

def feeds(urls):
    with ThreadPoolExecutor(8) as pool:
        posts = [p for ps in pool.map(feed, urls) for p in ps]
    posts.sort(key=lambda p: -p["at"])
    return posts[:30]

def hn():
    try:
        hits = json.loads(get("https://hn.algolia.com/api/v1/search?tags=front_page&hitsPerPage=20"))["hits"]
    except Exception:
        return []
    out = []
    for h in hits:
        disc = HN + str(h["objectID"])
        site = urlsplit(h.get("url") or "").netloc.removeprefix("www.")
        out.append(post("hn", h.get("title") or "", h.get("url") or disc, h.get("created_at_i") or 0,
                        site, disc, h.get("points") or 0, h.get("num_comments") or 0))
    return out

def lobsters():
    try:
        stories = json.loads(get("https://lobste.rs/hottest.json"))[:20]
    except Exception:
        return []
    return [post("lobsters", s["title"], s["url"] or s["comments_url"], when(s["created_at"]),
                 " ".join(s["tags"]), s["comments_url"], s["score"], s["comment_count"]) for s in stories]

urls = [l.strip() for l in sys.stdin if l.strip()]
with ThreadPoolExecutor(3) as pool:
    a, b, c = pool.submit(feeds, urls), pool.submit(hn), pool.submit(lobsters)
    print(json.dumps({"feed": a.result(), "hn": b.result(), "lobsters": c.result()}))
'
  """) every 15m json timeout 40s
  source now = clock every 60s

  state tab = "all" persist

  let all = flatten([news.feed ?? [], news.hn ?? [], news.lobsters ?? []]).sortBy(p => -p.at).take(45)
  let items = tab == "all" ? all : (get(news, tab, []) ?? [])

  component Tab(id, label, tint) {
    Text {
      text: label; fontSize: 12; align: center; bold: tab == id
      color: tab == id ? tint : muted
      onTap: tab = id
    }
  }

  Column {
    gap: 4
    Row {
      gap: 0
      Tab { id: "all"; label: "all"; tint: foreground; weight: 1 }
      Tab { id: "feed"; label: "feed"; tint: accent; weight: 1 }
      Tab { id: "hn"; label: "hacker news"; tint: orange; weight: 1.6 }
      Tab { id: "lobsters"; label: "lobsters"; tint: red; weight: 1.3 }
    }
    if news == null {
      Text { text: "loading…"; style: small }
    } else {
      if len(items) == 0 {
        if tab == "feed" {
          Text { text: "nothing loaded: tap to check the feed list"; style: small; onTap: terminal('$EDITOR ~/.config/omarchy-proot/feeds', "feeds") }
        } else {
          Text { text: "nothing to show: tap to retry"; style: small; onTap: refresh() }
        }
      }
    }
    Column {
      scroll: true
      weight: 1
      gap: 6
      for p in items key p.id {
        let age = now - p.at
        let tint = p.kind == "hn" ? orange : p.kind == "lobsters" ? red : accent
        Column {
          gap: 0
          onTap: url(p.url)
          Text { text: p.title; fontSize: 13; maxLines: 2 }
          Row {
            gap: 6
            Text {
              text: p.kind == "feed" ? p.label : tab != "all" ? p.label : p.label == "" ? p.kind : "${p.kind} · ${p.label}"
              fontSize: 10; color: tint; maxLines: 1; weight: 1
            }
            if p.kind != "feed" {
              Text { text: "${p.pts} pts · ${p.com} com"; fontSize: 10; color: muted; width: 104; align: end; maxLines: 1; onTap: url(p.disc) }
            }
            Text {
              text: p.at == 0 ? "" : age < 3600 ? "${max(floor(age / 60), 1)}m" : age < 86400 ? "${floor(age / 3600)}h" : "${floor(age / 86400)}d"
              fontSize: 10; color: muted; width: 28; align: end
            }
          }
        }
      }
    }
    if tab == "feed" {
      Text { text: "edit the feed list"; fontSize: 10; color: muted; align: end; onTap: terminal('$EDITOR ~/.config/omarchy-proot/feeds', "feeds") }
    }
  }
}
